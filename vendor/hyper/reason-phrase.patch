+    let version_end = line.iter().position(|byte| *byte == b' ')?;
+    let status = &line[version_end + 1..];
+    let code_start = status.iter().position(|byte| *byte != b' ')?;
+    let after_code = status.get(code_start + 3..)?;
+    let reason = after_code.strip_prefix(b" ")?;
+    reason.iter().any(|byte| *byte >= 0x80).then_some(reason)
+}
